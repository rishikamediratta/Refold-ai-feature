{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Contact Object",
  "version": "2.0.0",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string",
      "description": "Unique CRM identifier for the contact",
      "example": "CNT-98421"
    },
    "first_name": {
      "type": "string",
      "description": "Contact given name",
      "example": "Sarah"
    },
    "last_name": {
      "type": "string",
      "description": "Contact surname",
      "example": "Jenkins"
    },
    "primary_email": {
      "type": "string",
      "format": "email",
      "description": "Primary communication email address (Renamed from contact_email)",
      "example": "s.jenkins@acmecorp.com"
    },
    "account_status": {
      "type": "object",
      "description": "Structured status object (Changed from primitive string to object)",
      "properties": {
        "status_code": {
          "type": "string",
          "enum": ["LD", "PR", "ACT", "CHR"]
        },
        "label": {
          "type": "string"
        }
      },
      "required": ["status_code", "label"]
    },
    "phone_number": {
      "type": "string",
      "description": "Primary phone contact",
      "example": "+1-555-0199"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Record creation timestamp",
      "example": "2024-01-15T09:30:00Z"
    }
  },
  "required": ["contact_id", "primary_email", "account_status"]
}
